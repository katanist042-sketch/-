user_input = input("ввод: ")
if not user_input:
    result = user_input
else:
    compressed = []
    count = 1 #кол-во повторений символа
    for i in range(1, len(user_input)): #начинаем со второго символа, так как сравниваем с предыдущим, считаем повторения
        if user_input[i] == user_input[i - 1]:
            count += 1 
        else:
            compressed.append(f"{user_input[i-1]}{count}")
            count = 1
    compressed.append(f"{user_input[-1]}{count}") #добавляем последний символ и его кол-во
    result = ''.join(compressed)
    result = result if len(result) < len(user_input) else user_input #выбираем более короткую строку
print(result)

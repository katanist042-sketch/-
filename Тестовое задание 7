user_input = input("ввод: ")
decoding = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000} #создаем словарь для декодирования римских чисел в арабские
total = 0
for i in range(len(user_input)-1): #делит выражение на символы, но не смотрит на последний символ, так как он не имеет следующего символа для сравнения
    symbol = decoding[user_input[i]] #получаем числовое значение символа
    next_symbol = decoding[user_input[i+1]] #получаем числовое значение следующего символа
    if symbol < next_symbol: #сравниваем символ с следующим символом
        total -= symbol
    else:                   #если символ больше или равен следующему символу, то просто добавляем его к общему результату
        total += symbol
total += decoding[user_input[-1]] #прибавляем последний символ
print(total)
